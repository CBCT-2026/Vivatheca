{
  "files": [
    {
      "glob": ".pitk/*.en.html",
      "lang": "en"
    },
    {
      "glob": ".pitk/*.ja.html",
      "lang": "ja"
    }
  ],
  "ignore_selectors": [
    "sup.cite",
    "rt",
    "rp",
    ".credit",
    ".refs",
    ".small",
    ".clin",
    ".status",
    ".review",
    ".disclaimer",
    ".pitk-skip",
    ".vt-video-review",
    ".vt-video-refs"
  ],
  "ignore_sections": [
    "^Sources$",
    "^出典$",
    "^For clinicians",
    "^医療者\\s*向\\s*け",
    "^About th(is|ese) models?$",
    "^3D printing$",
    "^3Dプリント"
  ],
  "address_reader": "you",
  "ja_address_reader": "omit",
  "ja_kanji": "jouyou",
  "jargon_allow": [
    "上顎洞",
    "上顎",
    "II",
    "III",
    "IV",
    "CT"
  ]
}
