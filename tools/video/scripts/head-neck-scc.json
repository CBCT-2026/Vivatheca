    "scene": "pre",
    "sentences": [
     {
      "text": "This model follows one real, published case.",
      "cite": [
       1
      ]
     },
     {
      "text": "A woman aged 72 had a cancer on her right lower gum, and it had grown into the bone.",
      "cite": [
       1
      ]
     }
    ]
   },
   {
    "scene": "op",
    "sentences": [
     {
      "text": "Surgeons took out the right side of her lower jaw in one piece, with its 8 teeth.",
      "cite": [
       1
      ]
     }
    ]
   },
   {
    "scene": "post",
    "sentences": [
     {
      "text": "This left a large gap.",
      "cite": []
     }
    ]
   },
   {
    "scene": "recon",
    "sentences": [
     {
      "text": "They rebuilt the jaw with bone from her leg (fibula).",
      "cite": [
       1,
       2
      ],
      "tts": "They rebuilt the jaw with bone from her leg, the fibula."
     },
     {
      "text": "Surgeons join its blood vessels to vessels in the neck, so the bone stays alive.",
      "cite": [
       2
      ]
     }
    ]
   },
   {
    "scene": "end",
    "sentences": [
     {
      "text": "Nine months later the new bone had taken well.",
      "cite": [
       1
      ]
     },
     {
      "text": "If you have had mouth cancer, you need regular checks for many years.",
      "cite": [
       1
      ]
     }
    ]
   }
  ]
 },
