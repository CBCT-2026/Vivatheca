  "paragraphs": [
   {
    "scene": "pre",
    "sentences": [
     {
      "text": "This model follows one real, published case.",
      "cite": [
       1
      ]
     },
     {
      "text": "A man aged 42 had a slow-growing lump in the roof of his mouth.",
      "cite": [
       1
      ]
     },
     {
      "text": "It was a slow type of cancer that starts in a small spit gland.",
      "cite": [
       1
      ]
     }
    ]
   },
   {
    "scene": "op",
    "sentences": [
     {
      "text": "The surgeon took out the lump with a cuff of normal lining, and kept the bone above it.",
      "cite": [
       1
      ]
     }
    ]
   },
   {
    "scene": "post",
    "sentences": [
     {
      "text": "He lost no teeth, and there was no hole into the nose.",
      "cite": [
       1
      ]
     }
    ]
   },
   {
    "scene": "recon",
    "sentences": [
     {
      "text": "A clear plastic plate protected the area while new lining grew.",
      "cite": [
       1
      ]
     }
    ]
   },
   {
    "scene": "end",
    "sentences": [
     {
      "text": "By 4 months the roof of the mouth had healed. He then had regular checks.",
      "cite": [
       1
      ]
     }
    ]
   }
  ]
 },
