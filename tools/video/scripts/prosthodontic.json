      {
        "scene": "low",
        "sentences": [
          {
            "text": "やがてあごの{土台|どだい}だけが{残|のこ}り、{奥|おく}は{低|ひく}く{平|たい}らになります。",
            "tts": "やがてあごのどだいだけがのこり、おくはひくくたいらになります。",
            "cite": [
              2
            ]
          }
        ]
      },
      {
        "scene": "denture",
        "sentences": [
          {
            "text": "{総入れ歯|そういれば}は{歯|は}ぐきにのります。{土手|どて}が{平|たい}らだと{動|うご}くことがあります。",
