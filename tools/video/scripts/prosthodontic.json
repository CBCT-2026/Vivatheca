        "sentences": [
          {
            "text": "{歯|は}を{失|うしな}うと、{土手|どて}は{何年|なんねん}もかけて{少|すこ}しずつやせていきます。",
            "tts": "はをうしなうと、どては、なんねんもかけて、すこしずつやせていきます。",
