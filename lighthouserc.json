{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Production server running",
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/models",
        "http://127.0.0.1:3000/models/impacted-wisdom-tooth",
        "http://127.0.0.1:3000/periodontitis/index.html",
        "http://127.0.0.1:3000/orthognathic/index.html",
        "http://127.0.0.1:3000/head-neck/scc/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "maxWaitForLoad": 45000
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.5
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 12000000
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 6000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
